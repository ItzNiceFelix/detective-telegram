# Vault chat id HARUS numerik (bukan @username) agar cocok dengan chat.id inbound webhook.
# Vault chat id HARUS numeric (bukan @username) agar cocok dengan chat.id inbound webhook.
# Detective Telegram — Environment Variables Template
# 
# SETUP GUIDE: docs/ENV-SETUP.md
# Copy this file to .env.local for local development
# For Vercel: Set each variable in Vercel dashboard Settings > Environment Variables
#
# DO NOT COMMIT real values of this file to git!
# .env.local and .env.production.local are in .gitignore

# ============================================================================
# TELEGRAM BOT (REQUIRED)
# ============================================================================

# Telegram Bot Token obtained from @BotFather
# Format: 123456:ABCDefghIJklmnoPQRstuvWXYZ1234567890ABC
# Setup guide: docs/ENV-SETUP.md § 1. TELEGRAM BOT SETUP
TELEGRAM_BOT_TOKEN=

# Telegram Webhook Secret (random string, generated by you)
# Used to validate webhook authenticity
# Generate: openssl rand -hex 32
# Setup guide: docs/ENV-SETUP.md § 2. TELEGRAM WEBHOOK SECRET SETUP
TELEGRAM_SECRET=

# ============================================================================
# FIREBASE / FIRESTORE (REQUIRED)
# ============================================================================

# Firebase Project ID
# From: Firebase Console > Project Settings > General
# Example: detective-telegram-123abc
# Setup guide: docs/ENV-SETUP.md § 3. FIREBASE / FIRESTORE SETUP
FIREBASE_PROJECT_ID=

# Firebase Client Email (from service account JSON)
# From: Firebase Service Account JSON
# Format: firebase-adminsdk-xyz123@project-id.iam.gserviceaccount.com
# Setup guide: docs/ENV-SETUP.md § 3.4. Extract Firebase Credentials
FIREBASE_CLIENT_EMAIL=

# Firebase Private Key (from service account JSON)
# IMPORTANT: Include entire key with \n preserved
# From: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Format: -----BEGIN PRIVATE KEY-----\nMIIEvA...\n-----END PRIVATE KEY-----\n
# Setup guide: docs/ENV-SETUP.md § 3.4. Extract Firebase Credentials
FIREBASE_PRIVATE_KEY=
# Firebase Storage Bucket (for durable AI case image assets)
# From: Firebase Console > Project Settings > Storage
# Format: <project-id>.appspot.com
# Needed only when AI image generation is ON (AI_PROVIDER=gemini + GEMINI_API_KEY)
FIREBASE_STORAGE_BUCKET=

# Asset storage provider: "FIREBASE_STORAGE" (default/canonical) | "TELEGRAM_BETA" (beta)
# ASSET_STORAGE_BETA = TELEGRAM_BETA (docs/ASSET-STORAGE-DECISION.md). file_id = BEST_EFFORT.
ASSET_STORAGE_PROVIDER=FIREBASE_STORAGE

# Private Telegram channel ID used as the beta asset vault (required when
# ASSET_STORAGE_PROVIDER=TELEGRAM_BETA). Must be separate from the gameplay group,
# bot must be able to upload media. Example format: -1001234567890
TELEGRAM_ASSET_VAULT_CHAT_ID=-5594167938

# ============================================================================
# ADMIN OPERATIONS (REQUIRED)
# ============================================================================

# Admin Secret Token (random string, generated by you)
# Used to authorize /api/admin endpoint
# Generate: openssl rand -hex 32
# Must be 32+ characters
# Setup guide: docs/ENV-SETUP.md § 4. ADMIN TOKEN SETUP
ADMIN_SECRET_TOKEN=

# ============================================================================
# AI PROVIDER (OPTIONAL)
# ============================================================================

# AI Provider: "openai" | "anthropic" | "gemini" | "fake"
# Default: "fake" (for closed beta, no API key needed)
# Setup guide: docs/ENV-SETUP.md § 5. AI PROVIDER SETUP
AI_PROVIDER=fake

# AI Model (varies by provider)
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus, claude-3-sonnet-20240229
# Gemini: gemini-1.5-pro
# Setup guide: docs/ENV-SETUP.md § 5. AI PROVIDER SETUP
AI_MODEL=

# OpenAI API Key (only if AI_PROVIDER=openai)
# From: https://platform.openai.com/api-keys
# Format: sk-...
# Setup guide: docs/ENV-SETUP.md § 5.3. OpenAI Setup
OPENAI_API_KEY=

# Anthropic API Key (only if AI_PROVIDER=anthropic)
# From: https://console.anthropic.com/
# Format: sk-ant-...
# Setup guide: docs/ENV-SETUP.md § 5.4. Anthropic Setup
ANTHROPIC_API_KEY=

# Google Gemini API Key (only if AI_PROVIDER=gemini)
# From: https://makersuite.google.com/app/apikey
# Format: AIza...
# Setup guide: docs/ENV-SETUP.md § 5.5. Google Gemini Setup
GOOGLE_GEMINI_API_KEY=

# xKiro API Key (only when ai_runtime_config.production.text.provider=xkiro)
# From: https://xkiro.com/ (dashboard/api keys)
# Used as Bearer credential for https://api.xkiro.com/v1/chat/completions.
# NEVER stored in Firestore. Setup guide: docs/XKIRO-PROVIDER.md
XKIRO_API_KEY=

# ============================================================================
# LOGGING & OBSERVABILITY (OPTIONAL)
# ============================================================================

# Log Level: "debug" | "info" | "warn" | "error"
# Recommended: debug (local), info (production)
# Setup guide: docs/ENV-SETUP.md § 6. LOGGING SETUP
LOG_LEVEL=info

# Environment: "local" | "staging" | "production"
# Used for logging and feature distinction
# Setup guide: docs/ENV-SETUP.md § 6.2. Environment Designation
NODE_ENV=local

# ============================================================================
# RATE LIMITING (OPTIONAL)
# ============================================================================

# Max actions per group per time window
# Default: 30 actions per minute
# Setup guide: docs/ENV-SETUP.md § 7. RATE LIMITING CONFIGURATION
RATE_LIMIT_MAX_ACTIONS=30

# Time window for rate limit in seconds
# Default: 60 (1 minute)
# Setup guide: docs/ENV-SETUP.md § 7. RATE LIMITING CONFIGURATION
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# FEATURE FLAGS (OPTIONAL)
# ============================================================================

# Enable cron jobs for maintenance (true | false)
# Default: false (disabled for closed beta)
# Setup guide: docs/ENV-SETUP.md § 8. CRON CONFIGURATION
ENABLE_CRON_JOBS=false

# Enable error stack traces in responses (true | false)
# Default: false (DO NOT enable in production!)
# Setup guide: docs/ENV-SETUP.md § 9. ERROR HANDLING CONFIGURATION
ENABLE_ERROR_STACK_TRACES=false

# ============================================================================
# LOCAL DEVELOPMENT SETUP
# ============================================================================
#
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Edit .env.local and fill in values from docs/ENV-SETUP.md
#
# 3. Start development server:
#    npm run dev
#
# ============================================================================
# VERCEL DEPLOYMENT SETUP
# ============================================================================
#
# 1. Link project:
#    vercel link
#
# 2. Add env vars via Vercel dashboard:
#    - Vercel > Project > Settings > Environment Variables
#    - Add each variable above
#    - Select Production, Preview, Development environments
#
# 3. Deploy:
#    vercel deploy --prod
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# - NEVER commit .env.local or .env.production.local to git
# - .env files are in .gitignore
# - All secrets should be 32+ characters
# - Rotate secrets if compromise suspected
# - Never share secrets via email, chat, or unsecured channels
# - Store production secrets only in Vercel/environment
#
# ============================================================================
# COMPLETE SETUP GUIDE: docs/ENV-SETUP.md
# ============================================================================